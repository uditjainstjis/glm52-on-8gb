+    const int K = env ? atoi(env) : 16;
+    if (K <= 0) return;
+    const size_t MIN_BYTES = 1u << 20; // ignore small tensors
+    for (int k = node_n + 1; k < node_n + 1 + K && k < cgraph->n_nodes; ++k) {
+        const struct ggml_tensor * n = cgraph->nodes[k];
+        if (!n || n->op != GGML_OP_MUL_MAT) continue;
+        const struct ggml_tensor * w = n->src[0];
+        if (!w || !w->data) continue;
+        if (ggml_nbytes(w) < MIN_BYTES) continue;
+        if (!is_mapped(w->data, ggml_nbytes(w))) continue;
+        ggml_moe_prefetch_tensor(w);
+    }
+}
