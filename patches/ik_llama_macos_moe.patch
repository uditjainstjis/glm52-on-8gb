+static inline bool populate_range(void * astart, size_t alen) {
+#if defined(__APPLE__)
+    (void) madvise(astart, alen, MADV_WILLNEED);
+    const long page = sysconf(_SC_PAGESIZE);
+    volatile const char * p = (volatile const char *) astart;
+    char sink = 0;
+    for (size_t off = 0; off < alen; off += (size_t)page) {
