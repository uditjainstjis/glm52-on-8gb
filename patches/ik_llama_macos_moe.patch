diff --git a/ggml/include/ggml-metal.h b/ggml/include/ggml-metal.h
index d483cf1..bdba3ab 100644
--- a/ggml/include/ggml-metal.h
+++ b/ggml/include/ggml-metal.h
@@ -46,6 +46,11 @@ GGML_API ggml_backend_t ggml_backend_metal_init(void);
 
 GGML_API bool ggml_backend_is_metal(ggml_backend_t backend);
 
+// Apple Silicon unified memory: report what Metal will let us allocate.
+// Without this, llama_get_device_memory() falls through to `return 1;` and the
+// safety-margin check silently disables ALL GPU offload on macOS.
+GGML_API void ggml_backend_metal_get_device_memory(size_t * free, size_t * total);
+
 GGML_API GGML_CALL ggml_backend_buffer_t ggml_backend_metal_buffer_from_ptr(void * data, size_t size, size_t max_size);
 
