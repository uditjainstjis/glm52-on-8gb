+// Graph-level trunk lookahead: populate upcoming STATIC weights (plain MUL_MAT)
+// while the current node computes. Routed experts (MUL_MAT_ID) are skipped --
+// their ids are not known until the router runs, and the kernel hook covers them.
+
+// Trailing evict: release weights of nodes we have already finished with, so the
+// page cache has room for the lookahead. Working set is ~3x cache, so consumed
+// pages otherwise evict incoming prefetches (measured 1.68x page re-read).
+void ggml_trunk_evict_trailing(const struct ggml_cgraph * cgraph, int node_n) {
+    if (!cgraph) return;
+    const char * env = getenv("GGML_TRUNK_EVICT");
+    const int lag = env ? atoi(env) : 0;   // 0 = disabled by default
+    if (lag <= 0) return;
+    const int k = node_n - lag;
+    if (k < 0) return;
+    const struct ggml_tensor * n = cgraph->nodes[k];
+    if (!n) return;
+    for (int si = 0; si < 2; ++si) {
+        const struct ggml_tensor * w = n->src[si];
+        if (!w || !w->data) continue;
+        const size_t nb = ggml_nbytes(w);
+        if (nb < (1u << 20)) continue;
+        if (!is_mapped(w->data, nb)) continue;
+        const uintptr_t page_mask = (uintptr_t)sysconf(_SC_PAGESIZE) - 1;
+        const uintptr_t astart = ((uintptr_t)w->data) & ~page_mask;
+        const size_t alen = ((uintptr_t)w->data + nb) - astart;
+#if defined(__APPLE__)
+        (void) msync((void *)astart, alen, MS_INVALIDATE);
+#else
+        (void) madvise((void *)astart, alen, MADV_COLD);
+#endif
+    }
