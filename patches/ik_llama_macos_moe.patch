diff --git a/ggml/src/ggml-metal.m b/ggml/src/ggml-metal.m
index 323d4e4..9e56151 100644
--- a/ggml/src/ggml-metal.m
+++ b/ggml/src/ggml-metal.m
@@ -4512,6 +4512,18 @@ ggml_backend_t ggml_backend_metal_init(void) {
     return metal_backend;
 }
 
+void ggml_backend_metal_get_device_memory(size_t * free, size_t * total) {
+    id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+    size_t rec = 0, cur = 0;
+    if (device) {
+        rec = (size_t) device.recommendedMaxWorkingSetSize;
+        cur = (size_t) device.currentAllocatedSize;
+        [device release];
+    }
+    if (total) *total = rec;
+    if (free)  *free  = rec > cur ? rec - cur : 0;
+}
+
 bool ggml_backend_is_metal(ggml_backend_t backend) {
     return backend != NULL && ggml_guid_matches(backend->guid, ggml_backend_metal_guid());
 }
